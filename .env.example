# ── Supabase (proyecto NUEVO, separado de Vortex) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Web Push (VAPID) — genera con: npx web-push generate-vapid-keys ────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://isyconta.mx

# ── Crons / seguridad ──────────────────────────────────────────────────────
CRON_SECRET=

# ── Contadigital (FUTURO — fase de facturación, aún no se usa) ──────────────
# Solicitar credenciales de la API REST a Contadigital (Isyconta ya es cliente).
CONTADIGITAL_API_BASE=
CONTADIGITAL_API_TOKEN=
